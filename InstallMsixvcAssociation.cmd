@echo off
setlocal

net session >nul 2>&1
if "%errorlevel%"=="0" goto elevated

powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "Start-Process -FilePath '%~f0' -Verb RunAs"
exit /b

:elevated
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "try { $ErrorActionPreference='Stop'; $dir=Join-Path $env:ProgramFiles 'InstallMsixvcGH'; $script=Join-Path $dir 'InstallMsixvcGH.ps1'; New-Item -ItemType Directory -Path $dir -Force | Out-Null; $helper=Join-Path $dir 'gamelaunchhelper.exe'; [Net.ServicePointManager]::SecurityProtocol=[Net.ServicePointManager]::SecurityProtocol -bor [Net.SecurityProtocolType]::Tls12; try { Write-Host 'Downloading gamelaunchhelper.exe...'; Invoke-WebRequest -Uri 'https://raw.githubusercontent.com/OnixClient/onix_compatible_appx/main/gamelaunchhelper.exe' -OutFile $helper -UseBasicParsing } catch { $helper=$null; Write-Host 'Warning: could not download gamelaunchhelper.exe now; it will be downloaded to TEMP on each install instead.' -ForegroundColor Yellow; Write-Host $_ }; $content=[Text.Encoding]::UTF8.GetString([Convert]::FromBase64String('')); Set-Content -Path $script -Value $content -Encoding UTF8 -Force; $prog='MsixvcInstallerGH.File'; $ps=Join-Path $env:SystemRoot 'System32\WindowsPowerShell\v1.0\powershell.exe'; $command=([char]34)+$ps+([char]34)+' -NoProfile -ExecutionPolicy Bypass -File '+([char]34)+$script+([char]34)+' '+([char]34)+([char]37)+'1'+([char]34); foreach($root in @('Registry::HKEY_CURRENT_USER\Software\Classes','Registry::HKEY_LOCAL_MACHINE\Software\Classes')) { New-Item -Path ($root+'\.msixvc') -Force | Out-Null; Set-Item -Path ($root+'\.msixvc') -Value $prog; New-Item -Path ($root+'\'+$prog) -Force | Out-Null; Set-Item -Path ($root+'\'+$prog) -Value 'MSIXVC Package Installer (GH edition)'; New-Item -Path ($root+'\'+$prog+'\shell\open\command') -Force | Out-Null; Set-Item -Path ($root+'\'+$prog+'\shell\open\command') -Value $command }; Write-Host 'Installed:'; Write-Host ('  '+$script); if ($helper) { Write-Host ('  '+$helper) }; Write-Host ''; Write-Host 'Association command:'; Write-Host ('  '+$command); Write-Host ''; Read-Host 'Done. Press Enter to close' } catch { Write-Host ''; Write-Host 'Installer failed:' -ForegroundColor Red; Write-Host $_; Read-Host 'Press Enter to close'; exit 1 }"